// Служебный запуск только для локальной демобазы, созданной onec_demo.py.
Процедура ПриНачалеРаботыСистемы()
    Если СтрНайти(ПараметрЗапуска, "demo-access|") = 1 Тогда
        Аргументы = СтрРазделить(ПараметрЗапуска, "|");
        DemoFixtures.ПодготовитьДоступ(Аргументы[1]);
        ЗавершитьРаботуСистемы(Ложь);
        Возврат;
    КонецЕсли;
    Если СтрНайти(ПараметрЗапуска, "demo-readonly|") = 1 Тогда
        Аргументы = СтрРазделить(ПараметрЗапуска, "|");
        DemoFixtures.ПроверитьТолькоЧтение(Аргументы[1]);
        ЗавершитьРаботуСистемы(Ложь);
        Возврат;
    КонецЕсли;
    Если СтрНайти(ПараметрЗапуска, "demo-seed|") <> 1 Тогда
        Возврат;
    КонецЕсли;
    Аргументы = СтрРазделить(ПараметрЗапуска, "|");
    Если Аргументы.Количество() <> 3 Тогда
        ВызватьИсключение "Ожидаются путь фикстур и путь отчета";
    КонецЕсли;
    DemoFixtures.ЗагрузитьИПроверить(Аргументы[1], Аргументы[2]);
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры
