                                                // Возвращает лицевые счета в формате контракта.Функция GetAccounts(Запрос)	Данные = Новый Массив;	ЗапросДанных = Новый Запрос;	ЗапросДанных.Текст =	"ВЫБРАТЬ	|	ЛицевыеСчета.ВнешнийID КАК ВнешнийID,	|	ЛицевыеСчета.НомерСчета КАК НомерСчета	|ИЗ	|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета	|ГДЕ	|	НЕ ЛицевыеСчета.ПометкаУдаления";	Выборка = ЗапросДанных.Выполнить().Выбрать();	Пока Выборка.Следующий() Цикл		Запись = Новый Структура;		Запись.Вставить("id", Выборка.ВнешнийID);		Запись.Вставить("account_number", Выборка.НомерСчета);		Данные.Добавить(Запись);	КонецЦикла;	Возврат СоздатьJSONОтвет(Данные);КонецФункции// Возвращает начисления. Суммы передаются целым числом копеек.Функция GetCharges(Запрос)	Данные = Новый Массив;	ЗапросДанных = Новый Запрос;	ЗапросДанных.Текст =	"ВЫБРАТЬ	|	Начисления.ВнешнийID КАК ВнешнийID,	|	Начисления.ЛицевойСчет.ВнешнийID КАК ВнешнийIDСчета,	|	Начисления.Период КАК Период,	|	Начисления.СуммаКопеек КАК СуммаКопеек	|ИЗ	|	Справочник.Начисления КАК Начисления	|ГДЕ	|	НЕ Начисления.ПометкаУдаления";	Выборка = ЗапросДанных.Выполнить().Выбрать();	Пока Выборка.Следующий() Цикл		Запись = Новый Структура;		Запись.Вставить("id", Выборка.ВнешнийID);		Запись.Вставить("account_id", Выборка.ВнешнийIDСчета);		Запись.Вставить("period", Выборка.Период);		Запись.Вставить("amount_kopecks", Выборка.СуммаКопеек);		Данные.Добавить(Запись);	КонецЦикла;	Возврат СоздатьJSONОтвет(Данные);КонецФункции// Возвращает платежи с датой в формате YYYY-MM-DD.Функция GetPayments(Запрос)	Данные = Новый Массив;	ЗапросДанных = Новый Запрос;	ЗапросДанных.Текст =	"ВЫБРАТЬ	|	Платежи.ВнешнийID КАК ВнешнийID,	|	Платежи.ЛицевойСчет.ВнешнийID КАК ВнешнийIDСчета,	|	Платежи.ДатаПлатежа КАК ДатаПлатежа,	|	Платежи.СуммаКопеек КАК СуммаКопеек	|ИЗ	|	Справочник.Платежи КАК Платежи	|ГДЕ	|	НЕ Платежи.ПометкаУдаления";	Выборка = ЗапросДанных.Выполнить().Выбрать();	Пока Выборка.Следующий() Цикл		Запись = Новый Структура;		Запись.Вставить("id", Выборка.ВнешнийID);		Запись.Вставить("account_id", Выборка.ВнешнийIDСчета);		Запись.Вставить(			"date",			Формат(Выборка.ДатаПлатежа, "ДФ=yyyy-MM-dd")		);		Запись.Вставить("amount_kopecks", Выборка.СуммаКопеек);		Данные.Добавить(Запись);	КонецЦикла;	Возврат СоздатьJSONОтвет(Данные);КонецФункции// Все методы возвращают одинаковую оболочку: {"value": [...]}.Функция СоздатьJSONОтвет(Данные)	ТелоОтвета = Новый Структура;	ТелоОтвета.Вставить("value", Данные);	ЗаписьJSON = Новый ЗаписьJSON;	ЗаписьJSON.УстановитьСтроку();	ЗаписатьJSON(ЗаписьJSON, ТелоОтвета);	СтрокаJSON = ЗаписьJSON.Закрыть();	Ответ = Новый HTTPСервисОтвет(200);	Ответ.Заголовки.Вставить(		"Content-Type",		"application/json; charset=utf-8"	);	Ответ.УстановитьТелоИзСтроки(СтрокаJSON);	Возврат Ответ;КонецФункции